{
  "name": "zfb-example-ai-summarizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "rm -rf build dist .zfb output worker",
    "dev": "zfb dev",
    "build": "zfb build",
    "preview": "zfb preview",
    "typecheck": "zfb check",
    "dev:cf": "pnpm build && concurrently --names 'wrangler,watch' --kill-others 'wrangler dev --env ai --port 8788' \"chokidar 'pages/**/*.{ts,tsx,md,mdx}' 'components/**/*.{ts,tsx}' 'lib/**/*.ts' 'styles/**/*.css' 'zfb.config.ts' --command 'pnpm build' --initial false --debounce 200\""
  },
  "dependencies": {
    "@takazudo/zfb": "3.1.0",
    "@takazudo/zfb-adapter-cloudflare": "3.1.0",
    "@takazudo/zfb-runtime": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.0",
    "wrangler": "4.127.0"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
